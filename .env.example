# FlexFit Environment Configuration Template
# Copy this file to .env (which is gitignored) and fill in your local/production values.
# NEVER commit real passwords, secrets, or keys to version control.

# Server
SERVER_PORT=8080

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=flexfit_db
DB_USER=flexfit_user
DB_PASSWORD=replace_with_your_mysql_password

# JWT Authentication (Generate a strong random 32+ byte secret for production)
JWT_SECRET=replace_with_a_cryptographically_random_256_bit_secret_key
JWT_EXPIRATION_MS=86400000

# Web Cookie Security (Set to true when serving over HTTPS in production)
COOKIE_SECURE=false

# CORS & Microservice URLs
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
ML_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ML_SERVICE_URL=http://localhost:8000
BACKEND_URL=http://localhost:8080
